# Copie para .env e ajuste. O arquivo .env NÃO é versionado.
# Os valores abaixo são os mesmos padrões do docker-compose.yml (somente para desenvolvimento local).
# Atenção: o Postgres só aplica POSTGRES_PASSWORD quando o volume é criado. Se trocar a senha depois,
# recrie o volume (docker compose down -v) ou o login vai falhar com "password authentication failed".
POSTGRES_USER=salesgreen
POSTGRES_PASSWORD=salesgreen_dev
RABBITMQ_USER=salesgreen
RABBITMQ_PASSWORD=salesgreen_dev
# Portas no host (troque se já estiverem em uso na sua máquina, ex.: CASSANDRA_PORT=19042)
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
CASSANDRA_PORT=9042
